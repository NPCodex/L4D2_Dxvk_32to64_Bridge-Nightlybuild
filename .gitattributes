* text=auto eol=lf
*.patch -text whitespace=-blank-at-eol,-space-before-tab
*.py text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
# Preserve the supplied L4N SDK header byte-for-byte, including CRLF.
plugins/l4n/sdk/l4n_plugin.h -text whitespace=-blank-at-eol,cr-at-eol
# Preserve original L4N files and the supplied presets byte-for-byte.
runtime/l4n/payload/** -text -diff
# Preserve upstream raw validation evidence and its published checksums.
docs/ipc-c32-evidence/** -text whitespace=cr-at-eol
docs/ipc-full-evidence/** -text whitespace=cr-at-eol
docs/ipc-v2-evidence/** -text whitespace=cr-at-eol
docs/vbib-mapped-evidence/** -text whitespace=cr-at-eol
