+DECL_BRIDGE_FUNC(void, startRead, const Header& header) {
+  if (s_readActive) { return; }
+  const auto& channel = getReaderChannel();
+#ifdef REMIX_BRIDGE_SERVER
+  if (header.flags & ldb_c32::Inline) {
+    if (header.dataOffset != channel.data->get_pos() || (header.flags & Commands::DataFullRing)) { failRead(); }
+    uint32_t words = 0;
+    s_inlineCursor = channel.commands->readInline(words);
+    s_inlineEnd = s_inlineCursor + words;
+    s_inlineRead = s_readActive = true; return;
+  }
+#endif
+  const auto capacity = static_cast<uint32_t>(channel.data->get_total_size());
+  if (!bridge_data::compatible(*channel.control, capacity)) {
+    Logger::err("IPC protocol/control layout mismatch; mixed Client/Host refused");
+    failRead();
+  }
+  if (header.dataOffset >= capacity) { failRead(); }
+  const auto start = channel.data->cursor();
+  const auto position = static_cast<uint32_t>(channel.data->get_pos());
+  uint64_t words = header.dataOffset >= position ? header.dataOffset - position
+    : capacity - (position - header.dataOffset);
+  if (header.flags & Commands::FlagBits::DataFullRing) {
+    if (words) { failRead(); }
+    words = capacity;
+  }
+  if (start > UINT64_MAX - words) { failRead(); }
+  const auto end = start + words;
+  // A frontier already acquired from this channel remains a valid lower bound.
+  // Refresh only when the next Header extends beyond it, just like cachedConsumed.
+  if (end > channel.cachedPublished) {
+    channel.cachedPublished = channel.control->published.load(std::memory_order_acquire);
+    if (end > channel.cachedPublished) { failRead(); }
+  }
+  s_readEnd = start + words;
+  s_readActive = true;
+}
+
+DECL_BRIDGE_FUNC(void, startPendingRead) {
+    Result result;
+    const auto header = getReaderChannel().commands->peek(result, 1);
+    if (result != Result::Success) { failRead(); }
+    startRead(header);
+}
+
+DECL_BRIDGE_FUNC(void, failRead) {
+  getReaderChannel().control->fault.store(1, std::memory_order_release);
+  gbBridgeRunning.store(false, std::memory_order_release);
+  throw BridgeReadFailure {};
+}
+
+DECL_BRIDGE_FUNC(size_t, end_read_data) {
+  const auto& channel = getReaderChannel();
+#ifdef REMIX_BRIDGE_SERVER
+  if (s_inlineRead) {
+    if (!s_readActive || s_inlineCursor != s_inlineEnd) { failRead(); }
+    // An inline Unlock/Destroy may release a Data Ring pin without moving
+    // that ring's cursor. Publish the newly reclaimable frontier before the
+    // message block credit, or a full upload ring could stall indefinitely.
+    if (s_pinsChanged) {
+      uint64_t consumed = channel.data->cursor();
+      for (const auto& resource : s_readPins) {
+        if (!resource.second.empty()) { consumed = std::min(consumed, resource.second.front()); }
+      }
+      channel.control->consumed.store(consumed, std::memory_order_seq_cst);
+      if (channel.control->waiting.load(std::memory_order_seq_cst)) { channel.dataSemaphore->release(); }
+      s_pinsChanged = false;
+    }
+    s_readActive = s_inlineRead = false;
+    channel.commands->finishRead(); return 0;
+  }
+#endif
+  if (!s_readActive || channel.data->cursor() != s_readEnd) { failRead(); }
+  uint64_t consumed = channel.data->cursor();
+  for (const auto& resource : s_readPins) {
+    if (!resource.second.empty()) { consumed = std::min(consumed, resource.second.front()); }
+  }
+  s_pinsChanged = false;
+  channel.control->consumed.store(consumed, std::memory_order_seq_cst);
+  if (channel.control->waiting.load(std::memory_order_seq_cst)) { channel.dataSemaphore->release(); }
+  s_readActive = false;
+#ifdef REMIX_BRIDGE_SERVER
+  channel.commands->finishRead();
+#endif
+  return channel.data->end_batch();
+}
