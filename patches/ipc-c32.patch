+DECL_BRIDGE_FUNC(bridge_util::Result, waitDataQueue, uint64_t end, uint64_t current) {
+  auto& channel = *s_pWriterChannel;
+  const auto capacity = static_cast<uint32_t>(channel.data->get_total_size());
+  const auto begin = GetTickCount64();
+  const auto initialConsumed = channel.cachedConsumed;
+  const uint64_t configured = static_cast<uint64_t>(GlobalOptions::getCommandTimeout())
+    * std::max<uint32_t>(1, GlobalOptions::getCommandRetries());
+  const uint64_t budget = configured ? std::min<uint64_t>(configured, 120000) : 120000;
+  Result waitResult = Result::Success;
+  l4d2_api_wait::Span timing(l4d2_api_wait::Metric::DataQueueWait);
+  const bool success = bridge_data::waitForSpace(*channel.control, end, capacity,
+    [&]() { channel.cachedConsumed = channel.control->consumed.load(std::memory_order_seq_cst); return channel.cachedConsumed; },
+    [&]() {
+      const auto elapsed = GetTickCount64() - begin;
+      if (elapsed >= budget) { waitResult = Result::Timeout; return false; }
+      waitResult = channel.dataSemaphore->wait(static_cast<DWORD>(std::min<uint64_t>(25, budget - elapsed)));
+      return waitResult != Result::Failure;
+    }, [&]() { return healthy(); });
+  if (!success) {
+    if (!gbBridgeRunning.load(std::memory_order_acquire)) { waitResult = Result::Failure; }
+    reportFault(waitResult == Result::Timeout ? "timeout" : "wait-failed-or-peer-cancelled",
+      s_curCommand, s_curUID, end - current, begin, initialConsumed);
+    return waitResult == Result::Timeout ? Result::Timeout : Result::Failure;
+  }
+  return Result::Success;
+}
