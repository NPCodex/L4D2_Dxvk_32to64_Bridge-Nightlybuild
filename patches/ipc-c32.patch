+// Process-lifetime state: a delayed/in-flight wrapper remains callable after stop.
+// Only the selected loaded renderer's named IAT entries are observed. Never
+// detour USER32 globally, load Steam, change a PID, or patch DLL code.
+// Optional adapter substitutes only eligible game HWNDs in renderer imports.
+class Diagnostics {
+public:
+  using Log = void (*)(const char*);
+private:
+  using WindowFn = HWND (WINAPI*)();
+  using HookFn = HHOOK (WINAPI*)(int, HOOKPROC, HINSTANCE, DWORD);
+  struct Entry { const char* name; void* wrapper; void* original; void** slot; };
+  struct Site { unsigned api; uintptr_t caller; DWORD thread; HWND window; DWORD pid; ULONGLONG next; bool used; };
+  inline static Entry entries[3] = {
+    { "GetActiveWindow", nullptr, nullptr, nullptr },
+    { "GetForegroundWindow", nullptr, nullptr, nullptr },
+    { "SetWindowsHookExW", nullptr, nullptr, nullptr }
+  };
+  inline static Site sites[128] {};
+  inline static SRWLOCK lock = SRWLOCK_INIT;
+  inline static std::atomic<bool> enabled { false }, adapting { false };
+  inline static std::atomic<HWND> game { nullptr }, presenter { nullptr };
+  inline static std::atomic<unsigned long long> calls[3] {}, dropped { 0 };
+  inline static HMODULE module = nullptr;
+  inline static Log logger = nullptr;
+  inline static unsigned lines = 0;
+  inline static bool attempted = false, waitingReported = false;
+  inline static thread_local bool observing = false;
+  struct ErrorGuard { DWORD error = GetLastError(); ~ErrorGuard() { SetLastError(error); } };
+  static void emit(const char* line) noexcept { try { if (logger) logger(line); } catch (...) {} }
+  static DWORD owner(HWND window) { DWORD pid = 0; if (window) GetWindowThreadProcessId(window, &pid); return pid; }
+  static bool range(size_t offset, size_t length, size_t size) { return offset <= size && length <= size - offset; }
+  static bool named(const BYTE* base, size_t offset, size_t size, const char* text) {
+    const size_t length = std::strlen(text) + 1;
+    return range(offset, length, size) && std::memcmp(base + offset, text, length) == 0;
+  }
+  static bool exchange(void** slot, void* replacement, void* expected) {
+    DWORD protection = 0;
+    if (!VirtualProtect(slot, sizeof(void*), PAGE_READWRITE, &protection)) return false;
+    void* previous = InterlockedCompareExchangePointer(reinterpret_cast<void* volatile*>(slot), replacement, expected);
+    DWORD ignored = 0;
+    const BOOL restored = VirtualProtect(slot, sizeof(void*), protection, &ignored);
+    if (!restored) emit("L4D2_STEAM_WINDOW event=protection-error");
+    return previous == expected;
+  }
+  // Caller is an ordinary loader-backed PE for this process's architecture.
+  // Bounds checks protect all import-table/name/thunk walks against bad RVAs.
+  static unsigned attach(HMODULE loaded) {
+    const auto base = reinterpret_cast<BYTE*>(loaded);
+    MEMORY_BASIC_INFORMATION memory {};
+    if (!VirtualQuery(base, &memory, sizeof(memory)) || memory.Type != MEM_IMAGE) return 0;
+    const auto dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
+    if (memory.RegionSize < sizeof(*dos) || dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew < 0
+      || !range(static_cast<size_t>(dos->e_lfanew), sizeof(IMAGE_NT_HEADERS), memory.RegionSize)) return 0;
+    const auto nt = reinterpret_cast<const IMAGE_NT_HEADERS*>(base + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE || nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR_MAGIC
+      || nt->OptionalHeader.NumberOfRvaAndSizes <= IMAGE_DIRECTORY_ENTRY_IMPORT) return 0;
+    const size_t size = nt->OptionalHeader.SizeOfImage;
+    char identity[250] {};
+    std::snprintf(identity, sizeof(identity), "L4D2_STEAM_WINDOW event=image timestamp=0x%lx image_size=0x%zx", nt->FileHeader.TimeDateStamp, size);
+    emit(identity);
+    const auto imports = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
+    if (!imports.VirtualAddress || !range(imports.VirtualAddress, imports.Size, size)) return 0;
+    unsigned found = 0;
+    for (size_t offset = imports.VirtualAddress; range(offset, sizeof(IMAGE_IMPORT_DESCRIPTOR), size)
+      && range(offset - imports.VirtualAddress, sizeof(IMAGE_IMPORT_DESCRIPTOR), imports.Size); offset += sizeof(IMAGE_IMPORT_DESCRIPTOR)) {
+      const auto descriptor = reinterpret_cast<const IMAGE_IMPORT_DESCRIPTOR*>(base + offset);
+      if (!descriptor->Name) break;
+      // Names can belong to API-set DLLs; identify the three exact functions.
+      if (!descriptor->OriginalFirstThunk || !descriptor->FirstThunk) continue;
+      for (size_t i = 0; i < size / sizeof(IMAGE_THUNK_DATA); ++i) {
+        const size_t nameOffset = static_cast<size_t>(descriptor->OriginalFirstThunk) + i * sizeof(IMAGE_THUNK_DATA);
+        const size_t slotOffset = static_cast<size_t>(descriptor->FirstThunk) + i * sizeof(IMAGE_THUNK_DATA);
+        if (!range(nameOffset, sizeof(IMAGE_THUNK_DATA), size) || !range(slotOffset, sizeof(IMAGE_THUNK_DATA), size)) break;
+        const auto thunk = reinterpret_cast<const IMAGE_THUNK_DATA*>(base + nameOffset);
+        if (!thunk->u1.AddressOfData) break;
+        if (IMAGE_SNAP_BY_ORDINAL(thunk->u1.Ordinal)) continue;
+        const size_t name = static_cast<size_t>(thunk->u1.AddressOfData);
+        if (!range(name, sizeof(WORD), size)) continue;
+        for (unsigned api = 0; api < 3; ++api) {
+          auto& entry = entries[api];
+          if (entry.slot || !named(base, name + sizeof(WORD), size, entry.name)) continue;
+          void** slot = reinterpret_cast<void**>(base + slotOffset);
+          if (!*slot || *slot == entry.wrapper) continue;
+          entry.original = *slot; // Publish immutable original before wrapper.
+          MemoryBarrier();
+          if (exchange(slot, entry.wrapper, entry.original)) { entry.slot = slot; found |= 1u << api; }
+          char line[400] {};
+          std::snprintf(line, sizeof(line), "L4D2_STEAM_WINDOW event=import api=%s attached=%u slot_rva=0x%zx original=%p", entry.name, !!entry.slot, slotOffset, entry.original);
