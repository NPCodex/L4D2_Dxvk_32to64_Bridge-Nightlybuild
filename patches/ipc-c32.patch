+static bool steamMouseHandoffActive() {
+  static const bool enabled = Config::getOption<bool>("client.steamOverlayInput", false)
+    && Config::getOption<bool>("client.steamMouseCaptureHandoff", false);
+  if (!enabled || !RemixState::isUIActive() || !WndProc::isSteamOverlayActive()) { return false; }
+  const HWND game = WndProc::getHwnd();
+  const HWND foreground = GetForegroundWindow();
+  if (!game || !foreground) { return false; }
+  const HWND root = GetAncestor(game, GA_ROOT);
+  return root && GetAncestor(foreground, GA_ROOT) == root;
+}
+
+static bool steamGameCaptureWindow(HWND target) {
+  const HWND game = WndProc::getHwnd();
+  if (!game || !target || !IsWindow(target)) { return false; }
+  DWORD pid = 0;
+  GetWindowThreadProcessId(target, &pid);
+  const HWND root = GetAncestor(game, GA_ROOT);
+  return root && pid == GetCurrentProcessId() && GetAncestor(target, GA_ROOT) == root;
+}
+
+void DI::releaseSteamMouseCapture() {
+  const DWORD error = GetLastError();
+  if (!steamMouseHandoffActive()) { SetLastError(error); return; }
+  const HWND captured = GetCapture();
+  // ReleaseCapture is a thread operation: never release a Host or another thread's capture.
+  if (steamGameCaptureWindow(captured) && GetWindowThreadProcessId(captured, nullptr) == GetCurrentThreadId()) {
+    const BOOL released = ReleaseCapture();
+    observeInputSuppression("ReleaseCapture", _ReturnAddress(), released ? "release-game-capture" : "release-game-capture-failed");
+  }
+  SetLastError(error);
+}
+
+static HWND WINAPI HookedSetCapture(HWND window) {
+  const DWORD error = GetLastError();
+  if (steamMouseHandoffActive() && steamGameCaptureWindow(window)) {
+    const HWND previous = GetCapture();
+    observeInputSuppression("SetCapture", _ReturnAddress(), "deny-game-capture");
+    SetLastError(error);
+    return previous;
+  }
+  SetLastError(error);
+  return OrigSetCapture(window);
+}
