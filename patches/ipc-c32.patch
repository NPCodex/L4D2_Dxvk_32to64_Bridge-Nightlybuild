+        }
+      }
+    }
+    return found;
+  }
+  static void observe(unsigned api, const void* caller, HWND window, int kind = 0,
+    DWORD target = 0, HINSTANCE hookModule = nullptr, HHOOK result = nullptr, HOOKPROC procedure = nullptr, HWND realWindow = nullptr) noexcept {
+    if (!enabled.load(std::memory_order_acquire)) return;
+    ErrorGuard error;
+    ++calls[api];
+    if (observing || !TryAcquireSRWLockExclusive(&lock)) { ++dropped; return; }
+    observing = true;
+    const DWORD thread = GetCurrentThreadId();
+    const uintptr_t rva = reinterpret_cast<uintptr_t>(caller) - reinterpret_cast<uintptr_t>(module);
+    const ULONGLONG now = GetTickCount64();
+    Site* site = nullptr;
+    for (auto& candidate : sites) {
+      if (!candidate.used) { site = &candidate; break; }
+      if (candidate.api == api && candidate.caller == rva && candidate.thread == thread) { site = &candidate; break; }
+    }
+    if (site && lines < 4096 && (api == 2 || !site->used || site->window != window || now >= site->next)) {
+      const DWORD pid = owner(window);
+      *site = { api, rva, thread, window, pid, now + 1000, true };
+      char line[1100] {};
+      const HWND gameWindow = game.load(), presenterWindow = presenter.load();
+      if (api == 2) {
+        std::snprintf(line, sizeof(line), "L4D2_STEAM_WINDOW event=hook-install api=SetWindowsHookExW caller_rva=0x%zx thread=%lu host_pid=%lu hook_id=%d target_thread=%lu hook_module=%p procedure=%p result=%p last_error=%lu game=%p game_pid=%lu game_thread=%lu presenter=%p presenter_pid=%lu presenter_thread=%lu tick=%llu",
+          static_cast<size_t>(rva), thread, GetCurrentProcessId(), kind, target, hookModule, reinterpret_cast<void*>(procedure), result, error.error, gameWindow, owner(gameWindow), gameWindow ? GetWindowThreadProcessId(gameWindow, nullptr) : 0, presenterWindow, owner(presenterWindow), presenterWindow ? GetWindowThreadProcessId(presenterWindow, nullptr) : 0, now);
+      } else {
+        std::snprintf(line, sizeof(line), "L4D2_STEAM_WINDOW event=window-query api=%s caller_rva=0x%zx thread=%lu host_pid=%lu hwnd=%p owner_pid=%lu owner_thread=%lu same_process=%u game=%p game_pid=%lu game_thread=%lu presenter=%p presenter_pid=%lu presenter_thread=%lu last_error=%lu tick=%llu real_hwnd=%p real_pid=%lu result=%s",
+          entries[api].name, static_cast<size_t>(rva), thread, GetCurrentProcessId(), window, pid, window ? GetWindowThreadProcessId(window, nullptr) : 0, window && pid == GetCurrentProcessId(), gameWindow, owner(gameWindow), gameWindow ? GetWindowThreadProcessId(gameWindow, nullptr) : 0, presenterWindow, owner(presenterWindow), presenterWindow ? GetWindowThreadProcessId(presenterWindow, nullptr) : 0, error.error, now, realWindow, owner(realWindow), realWindow == window ? "unchanged" : "mapped");
+      }
+      ++lines; emit(line);
+      if (lines == 4096) emit("L4D2_STEAM_WINDOW event=trace-limit lines=4096");
+    } else if (!site) { ++dropped; }
+    observing = false;
+    ReleaseSRWLockExclusive(&lock);
+  }
+  static HWND WINAPI active() {
+    const HWND result = reinterpret_cast<WindowFn>(entries[0].original)();
+    HWND selected = result;
+    if (adapting.load(std::memory_order_acquire) && result) {
+      ErrorGuard error;
+      selected = selectWindow(result, GetForegroundWindow());
+    }
+    observe(0, _ReturnAddress(), selected, 0, 0, nullptr, nullptr, nullptr, result); return selected;
+  }
+  static HWND WINAPI foreground() {
+    const HWND result = reinterpret_cast<WindowFn>(entries[1].original)();
+    const HWND selected = selectWindow(result, result);
+    observe(1, _ReturnAddress(), selected, 0, 0, nullptr, nullptr, nullptr, result); return selected;
+  }
+  static HHOOK WINAPI hook(int kind, HOOKPROC procedure, HINSTANCE hookModule, DWORD target) {
+    const HHOOK result = reinterpret_cast<HookFn>(entries[2].original)(kind, procedure, hookModule, target);
+    observe(2, _ReturnAddress(), nullptr, kind, target, hookModule, result, procedure); return result;
