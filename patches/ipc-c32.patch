+DECL_BRIDGE_FUNC(void, reportFault, const char* reason, uint32_t command, uint32_t uid,
+    uint64_t words, uint64_t begin, uint64_t initialConsumed) noexcept {
+  const bool wasRunning = gbBridgeRunning.exchange(false, std::memory_order_acq_rel);
+#ifdef REMIX_BRIDGE_CLIENT
+  if (s_pWriterChannel) { s_pWriterChannel->commands->fault(); }
+#else
+  if (s_pReaderChannel) { s_pReaderChannel->commands->fault(); }
+#endif
+  if (!s_pWriterChannel || s_pWriterChannel->control->fault.exchange(1, std::memory_order_acq_rel)) { return; }
+  try {
+    const auto& channel = *s_pWriterChannel;
+    const auto peerPid = s_pReaderChannel ? s_pReaderChannel->control->writerPid.load(std::memory_order_acquire) : 0;
+    const auto peer = peerPid ? OpenProcess(SYNCHRONIZE, FALSE, peerPid) : nullptr;
+    const DWORD peerStatus = peer ? WaitForSingleObject(peer, 0) : WAIT_FAILED;
+    if (peer) { CloseHandle(peer); }
+    const auto consumed = channel.control->consumed.load(std::memory_order_acquire);
+    Logger::err(format_string("IPC_DATA_FAULT run=%s build=%s protocol=%u channel=%s self_pid=%lu peer_pid=%lu command=%u uid=%u request_words=%llu capacity=%u reserved=%llu published=%llu consumed=%llu wait_begin_ms=%llu elapsed_ms=%llu progress_changed=%u peer_alive=%s result=%s was_running=%u",
+      gUniqueIdentifier.toString().c_str(), bridge_data::buildIdentity, bridge_data::Version, channel.data->getName().c_str(),
+      GetCurrentProcessId(), static_cast<unsigned long>(peerPid), command, uid,
+      static_cast<unsigned long long>(words), static_cast<unsigned>(channel.data->get_total_size()),
+      static_cast<unsigned long long>(channel.data->cursor()), static_cast<unsigned long long>(channel.control->published.load()),
+      static_cast<unsigned long long>(consumed), static_cast<unsigned long long>(begin),
+      static_cast<unsigned long long>(begin ? GetTickCount64() - begin : 0), consumed != initialConsumed ? 1u : 0u,
+      peerStatus == WAIT_TIMEOUT ? "yes" : peerStatus == WAIT_OBJECT_0 ? "no" : "unknown",
+      reason, wasRunning ? 1u : 0u));
+  } catch (...) { /* Fault reporting must never prevent batch teardown. */ }
+}
